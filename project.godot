; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="munchi"
run/main_scene="uid://7eww7ww1n5aw"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/use_filter=false
boot_splash/image="uid://ce5nq5qowlnxv"
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://m06yc06g3kvg"

[autoload]

PlayerManager="*res://scenes/player/PlayerManager.tscn"
Settings="*res://scenes/ui/autoload/settings/Settings.tscn"
AudioManager="*res://scenes/ui/autoload/AudioManager.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor]

naming/scene_name_casing=1

[editor_plugins]

enabled=PackedStringArray("res://addons/AutoKey_SpriteFrames/plugin.cfg", "res://addons/TileMapDual/plugin.cfg", "res://addons/gaea/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "green",
"res://assets/resources/": "purple",
"res://scenes/": "orange",
"res://scenes/levels/rooms/": "red",
"res://scenes/ui/": "red"
}

[global_group]

player=""
runes=""
maps=""

[gui]

theme/default_font_subpixel_positioning=0

